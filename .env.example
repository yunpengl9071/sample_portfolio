# LLM API Keys
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# LangSmith (optional, for tracing)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=trialsense-ai

# Redis (for caching)
REDIS_URL=redis://localhost:6379

# Database
DUCKDB_PATH=./data/trialsense.db

# Vector Store
CHROMA_PERSIST_DIR=./data/vector_stores

# Model Settings
DEFAULT_LLM=gpt-4-turbo-preview
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Clinical Trials API
CLINICALTRIALS_API_BASE=https://clinicaltrials.gov/api/v2
CLINICALTRIALS_RATE_LIMIT=20

# Logging
LOG_LEVEL=INFO
